{
    "name": "omnistate/annuaire-sante",
    "type": "library",
    "description": "Omnistate Annuaire Santé: French health professionals (RPPS: profession, specialties, workplaces, MSSanté addresses) and facilities (FINESS) from the ANS's FHIR API.",
    "keywords": ["rpps", "finess", "annuaire sante", "ans", "fhir", "mssante", "health", "france", "omnistate"],
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": ">=8.2",
        "glitchr/omnistate": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {"psr-4": {"Omnistate\\AnnuaireSante\\": ""}, "exclude-from-classmap": ["/Tests/"]},
    "autoload-dev": {"psr-4": {"Omnistate\\AnnuaireSante\\Tests\\": "Tests/"}},
    "config": {"sort-packages": true}
}
